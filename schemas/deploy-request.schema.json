{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/deploy-request.schema.json",
  "title": "Deploy Request",
  "type": "object",
  "required": ["schema_version", "app_slug", "repo_url", "branch", "domain"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "app_slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "repo_url": {
      "type": "string"
    },
    "branch": {
      "type": "string",
      "default": "main"
    },
    "domain": {
      "type": "string"
    },
    "auth_provider": {
      "type": "string"
    },
    "healthcheck_path": {
      "type": "string"
    },
    "needs_database": {
      "type": "boolean"
    },
    "env_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

